rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Only include isAdmin if explicitly used. Here we use it for debugging/support.
    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == "Mohanad.md07@gmail.com" && request.auth.token.email_verified == true);
    }

    // ===============================================================
    // Validation Blueprints
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().size() <= 10 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidSearch(data) {
      return data.keys().hasAll(['userId', 'query', 'timestamp', 'resultCount']) &&
             data.keys().size() == 4 &&
             data.userId == request.auth.uid &&
             data.query is string && data.query.size() <= 500 &&
             data.timestamp == request.time &&
             data.resultCount is int;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Only allow updating certain fields
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin'])
      );
      
      allow delete: if isAdmin();

      // Search History (Subcollection)
      match /searches/{searchId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if isOwner(userId) || isAdmin();
        
        allow create: if isOwner(userId) && isValidSearch(incoming()) && isValidId(searchId);
        
        // Searches are immutable
        allow update, delete: if false;
      }
    }
  }
}
