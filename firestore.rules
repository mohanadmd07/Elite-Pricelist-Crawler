rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaffEmail(email) {
      return email in [
        'mohanad.md07@gmail.com',
        'uniquepower0@gmail.com',
        'dr.mohamed.mounir83@gmail.com',
        'dr.bassam.saqr@gmail.com',
        'drmohamedhamedahmedghazy@gmail.com',
        'ayaelkassas2013@gmail.com',
        'bofaridabofarida@gmail.com',
        'salmakhamishussien12@gmail.com',
        'moody203205@gmail.com'
      ];
    }

    function isAdmin() {
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (request.auth.token.email != null && (request.auth.token.email == 'mohanad.md07@gmail.com' || request.auth.token.email == 'uniquepower0@gmail.com'))
      );
    }

    function isAuthorizedStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^[^@]+@elitehospital[.]org$') ||
          isStaffEmail(request.auth.token.email)
        ))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User Profiles & Searches
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Search History (Subcollection)
      match /searches/{searchId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if false;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Collection Group for Searches (Admin analytics & inspection)
    match /{path=**}/searches/{searchId} {
      allow read: if isAdmin();
    }

    // Inpatient Approvals Collection (Strictly Authorized Hospital Staff & Outbox Worker)
    match /inpatient_approvals/{approvalId} {
      allow read: if isAuthorizedStaff();
      // Writes are restricted to authorized staff only. The previous second
      // disjunct let ANY authenticated principal (even a signed-in non-staff
      // account) forge approval records by setting mrn + a valid status —
      // a write hole. The outbox worker writes with an Admin SDK credential,
      // which bypasses rules entirely, so it needs no open path here.
      allow create, update: if isAuthorizedStaff();
      allow delete: if isAdmin();
    }

    // Companies / Contractors Configuration (Pricelist & Sales Officer Mappings)
    match /companies_config/{companyId} {
      allow read: if isAuthorizedStaff();
      allow create, update, delete: if isAdmin();
    }

    // Global Automation Settings (Pause / Resume / Polling Intervals)
    match /settings/{settingId} {
      allow read: if isAuthorizedStaff();
      allow create, update: if isAuthorizedStaff();
      allow delete: if isAdmin();
    }
  }
}
