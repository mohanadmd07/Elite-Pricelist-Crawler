rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (request.auth.token.email != null && request.auth.token.email == 'mohanad.md07@gmail.com')
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Search History (Subcollection)
      match /searches/{searchId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if false;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Collection Group for Searches (Admin analytics & inspection)
    match /{path=**}/searches/{searchId} {
      allow read: if isAdmin();
    }

    // Inpatient Approvals Collection (Operational Workflow & 30-day rollover purge)
    match /inpatient_approvals/{approvalId} {
      allow read, write: if isSignedIn();
    }

    // Companies / Contractors Configuration (Pricelist & Sales Officer Mappings)
    match /companies_config/{companyId} {
      allow read, write: if isSignedIn();
    }

    // Global Automation Settings (Pause / Resume / Polling Intervals)
    match /settings/{settingId} {
      allow read, write: if isSignedIn();
    }
  }
}
