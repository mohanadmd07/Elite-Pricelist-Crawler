rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaffEmail(email) {
      return email in [
        'mohanad.md07@gmail.com',
        'uniquepower0@gmail.com',
        'dr.mohamed.mounir83@gmail.com',
        'dr.bassam.saqr@gmail.com',
        'drmohamedhamedahmedghazy@gmail.com',
        'ayaelkassas2013@gmail.com',
        'bofaridabofarida@gmail.com',
        'salmakhamishussien12@gmail.com',
        'moody203205@gmail.com'
      ];
    }

    function isAdmin() {
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (request.auth.token.email != null && (request.auth.token.email == 'mohanad.md07@gmail.com' || request.auth.token.email == 'uniquepower0@gmail.com'))
      );
    }

    function isAuthorizedStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^[^@]+@elitehospital[.]org$') ||
          isStaffEmail(request.auth.token.email)
        ))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User Profiles & Searches
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Search History (Subcollection)
      match /searches/{searchId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if false;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Collection Group for Searches (Admin analytics & inspection)
    match /{path=**}/searches/{searchId} {
      allow read: if isAdmin();
    }

    // Inpatient Approvals Collection (Strictly Authorized Hospital Staff & Pipeline Workers)
    match /inpatient_approvals/{approvalId} {
      allow read: if isAuthorizedStaff();
      // Allow authorized staff or validated server/worker pipeline payloads with valid MRN and status
      allow create, update: if isAuthorizedStaff() || (
        request.resource.data.mrn != null &&
        request.resource.data.status in [
          'received', 'parsed', 'matched', 'sent', 'approved',
          'conditionally_approved', 'partially_approved', 'pending_information',
          'refused', 'new_request', 'draft_created', 'answered', 'unanswered',
          'needs_review', 'pending_manual_draft'
        ]
      );
      allow delete: if isAdmin();
    }

    // Companies / Contractors Configuration (Pricelist & Sales Officer Mappings)
    match /companies_config/{companyId} {
      allow read: if isAuthorizedStaff();
      allow create, update, delete: if isAdmin();
    }

    // Global Automation Settings (Pause / Resume / Polling Intervals)
    match /settings/{settingId} {
      allow read: if isAuthorizedStaff() || true;
      allow create, update: if isAuthorizedStaff() || (
        request.resource.data.keys().hasAny([
          'triggerSync', 'lastManualSyncTrigger', 'isSyncing', 'lastRunAt',
          'syncError', 'syncStateToken', 'lastSyncCompletedAt', 'lastSyncCount', 'lastSyncDurationMs'
        ])
      );
      allow delete: if isAdmin();
    }
  }
}
