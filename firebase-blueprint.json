{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user profile information for authentication and display.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth UID of the user." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "The user's profile picture URL." },
        "lastLogin": { "type": "string", "format": "date-time", "description": "The timestamp of the user's last login." }
      },
      "required": ["uid", "email"]
    },
    "SearchHistory": {
      "title": "Search History",
      "description": "Records of user searches and results found.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user who performed the search." },
        "query": { "type": "string", "description": "The search query string." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the search was performed." },
        "resultCount": { "type": "integer", "description": "Number of results found." }
      },
      "required": ["userId", "query", "timestamp", "resultCount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores individual user profile documents."
    },
    "/users/{userId}/searches/{searchId}": {
      "schema": "SearchHistory",
      "description": "Stores search history for a specific user."
    }
  }
}
