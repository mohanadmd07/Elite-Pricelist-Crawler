# ==============================================================
# Elite Pricelist Explorer & Inpatient Approvals Platform
# Environment Configuration Template (.env.example)
# ==============================================================

# --------------------------------------------------------------
# 1. GOOGLE GEMINI AI
# --------------------------------------------------------------
# Server-side Gemini API key used by the Watcher and Python Crawler pipelines.
GEMINI_API_KEY="AIzaSy..."

# Optional Client-side Gemini API key (fallback if user does not enter key via UI)
VITE_GEMINI_API_KEY=""

# --------------------------------------------------------------
# 2. SUPABASE POSTGRESQL (Source of Truth)
# --------------------------------------------------------------
# Supabase Project URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon Key (safe for frontend client queries subject to RLS)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (STRICTLY SERVER-SIDE for Watcher/Pipelines - bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --------------------------------------------------------------
# 3. FIREBASE & FIRESTORE (Derived Read Model)
# --------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_DATABASE_ID="(default)"

# Server-side Firebase Admin SDK Credentials (Optional for Node/Python workers)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------------
# 4. EXCHANGE WEB SERVICES (EWS) & IMAP (Approvals Watcher)
# --------------------------------------------------------------
IMAP_HOST="wmail.elitehospital.org"
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER="approvals@elitehospital.org"
IMAP_PASSWORD="your_secure_password"
EXCHANGE_DOMAIN="elitehospital"
IMAP_FOLDER="InApprovals"
IMAP_DRAFTS_FOLDER="Drafts"
POLL_INTERVAL_SECONDS=60
WATCHER_PORT=3001

# --------------------------------------------------------------
# 5. INTERNAL SERVICE AUTHORIZATION & SECURITY
# --------------------------------------------------------------
# Shared secret for authenticating internal API endpoints (/api/approvals, /api/contractors)
INTERNAL_API_SECRET="generate-a-strong-random-secret-key-32-chars-min"

# Allowed staff email domains for Google Auth sign-in (comma-separated)
ALLOWED_EMAIL_DOMAINS="elitehospital.org"

# Super-admin email addresses (comma-separated)
ADMIN_EMAILS="mohanad.md07@gmail.com"

# --------------------------------------------------------------
# 6. MEDICAL-AWARE APPROVAL REPLY CLASSIFIER & SELF-LEARNING
# --------------------------------------------------------------
CLASSIFIER_ENABLED=false
CLASSIFIER_OCR_ENABLED=true
CLASSIFIER_FLASH_MODEL="gemini-2.5-flash"
CLASSIFIER_PRO_MODEL="gemini-2.5-pro"
CORPORATE_SALES_RECIPIENT="corporate@elitehospital.org"
ALLOWED_RECIPIENT_DOMAINS="elitehospital.org"
PRICE_APPROVAL_AUTOSEND=false
LEARNING_ENABLED=false
LEARNING_WINDOW_MONTHS=24
LEARNING_HALF_LIFE_MONTHS=6
